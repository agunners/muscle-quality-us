# kept artifacts). Everything kept starts `qa_...`; intermediates start `_sweep_pool_`.
data/cohort_stats/_sweep_pool_*

# gws Drive export scratch — `gws drive files export` writes download.bin/.txt to cwd
download.*
data/intake_cache/
data/intake_hold/
