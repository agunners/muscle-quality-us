# Pull-only local mirror of Drive goruntuler/ (PHI-bearing study names) — never committed
data/goruntuler_mirror/
# Study-consistency audit report (regenerable; carries PHI-bearing study names) — never committed
data/audit/
configs/decision_log.csv

# regenerable per-capture segmentation cache (4MB+, keyed on segmenter bundle sha)
scripts/analysis/cache/

# doctors' grading pack (≈7 GB of renamed frames/videos; rebuilt by scripts/grading/build_grading_pack.py)
data/grading_pack/

